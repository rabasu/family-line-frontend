{
  "name": "family-line-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "next dev -p 3001",
    "predev": "node scripts/generate-pedigree-metadata.js && node scripts/generate-traditional-family-index.js && node scripts/generate-horse-link-map.js && node scripts/generate-horse-page-index.js && node scripts/generate-horse-search-index.js",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=12288 next dev -p 3001",
    "prebuild": "node scripts/generate-pedigree-metadata.js && node scripts/generate-traditional-family-index.js && node scripts/generate-horse-link-map.js && node scripts/generate-horse-page-index.js && node scripts/generate-horse-search-index.js",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=12288 next build && cross-env NODE_OPTIONS=--experimental-json-modules node ./scripts/postbuild.mjs",
    "serve": "next start",
    "preview": "node scripts/serve-out.js",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir app --dir components --dir scripts",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "1.7.19",
    "@next/bundle-analyzer": "14.2.3",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.12",
    "autoprefixer": "^10.4.13",
    "gray-matter": "^4.0.2",
    "next": "14.2.3",
    "next-themes": "^0.3.0",
    "postcss": "^8.4.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-variants": "^0.2.1",
    "tailwindcss": "^3.4.3"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.73",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "cross-env": "^7.0.3",
    "daisyui": "^4.12.10",
    "eslint": "^8.45.0",
    "eslint-config-next": "14.2.3",
    "husky": "^9.0.0",
    "lint-staged": "^13.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "typescript": "^5.1.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ],
    "app/**/*.+(js|jsx|ts|tsx)": [
      "cross-env NODE_OPTIONS='--max-old-space-size=4096' eslint --fix --max-warnings 0"
    ],
    "components/**/*.+(js|jsx|ts|tsx)": [
      "cross-env NODE_OPTIONS='--max-old-space-size=4096' eslint --fix --max-warnings 0"
    ]
  }
}
